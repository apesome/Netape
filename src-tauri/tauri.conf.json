{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netape",
  "version": "0.1.0",
  "identifier": "app.netape.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Netape",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 14 },
        "visible": false,
        "center": true,
        "backgroundColor": { "red": 30, "green": 30, "blue": 46, "alpha": 255 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.macos.plist"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
